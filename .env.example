GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Environment — only the exact string "staging" enables analysis by LOCAL PATH.
# Anything else (unset, misspelt, empty) is treated as production, where the
# pipeline can only analyse an imported GitHub repository.
#
# The default is restrictive because the local-path route is remote arbitrary
# file read and write once it is reachable: the pipeline sends every file it
# finds to Gemini and writes the answer back over the original. Forgetting this
# variable should cost you a local run, not the filesystem. Same shape as
# CREDITS_ENABLED below, where a slip cannot make the pipeline free.
APP_ENV=staging

# Auth
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@linterflow.local
ADMIN_PASSWORD=admin-change-me

# Credits — set to exactly "false" to disable billing: runs become free and
# every account reports an unlimited balance. Any other value (or none) keeps
# billing on. Accounts, roles and run history are unaffected either way.
CREDITS_ENABLED=true
